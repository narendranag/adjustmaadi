{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adjustmaadi",
  "compatibility_date": "2026-09-01",
  // A static site: Workers serves public/ as assets, with no Worker script.
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "adjustmaadi.com", "custom_domain": true },
    { "pattern": "www.adjustmaadi.com", "custom_domain": true }
  ]
}
